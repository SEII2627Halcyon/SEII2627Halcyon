{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-api",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/AppForSEII.API/AppForSEII.API.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-web",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/AppForSEII.Web/AppForSEII.Web.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test-unit",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/test/AppForSEII.UT/AppForSEII.UT.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test-ui",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/test/AppForSEII.UIT/AppForSEII.UIT.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}